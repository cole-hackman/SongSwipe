{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.songswipe.app",
  "productName": "SongSwipe",
  "asar": true,
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist-electron",
    "dist"
  ],
  "extraResources": [
    {
      "from": "sidecar/dist/rb-bridge",
      "to": "rb-bridge"
    },
    {
      "from": "sidecar",
      "to": "sidecar",
      "filter": ["rb_bridge.py", "commands.py", "requirements.txt"]
    }
  ],
  "mac": {
    "artifactName": "${productName}_${version}.${ext}",
    "target": ["dmg", "zip"],
    "extraResources": [
      {
        "from": "sidecar/dist/rb-bridge",
        "to": "rb-bridge"
      },
      {
        "from": "sidecar",
        "to": "sidecar",
        "filter": ["rb_bridge.py", "commands.py", "requirements.txt"]
      }
    ]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}_${version}.${ext}",
    "extraResources": [
      {
        "from": "sidecar/dist/rb-bridge.exe",
        "to": "rb-bridge.exe"
      },
      {
        "from": "sidecar",
        "to": "sidecar",
        "filter": ["rb_bridge.py", "commands.py", "requirements.txt"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  }
}
