{
  "name": "songswipe",
  "version": "0.1.0",
  "private": true,
  "description": "Tinder-style Rekordbox track culling desktop app",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vite",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build": "npm run build:sidecar && vite build && electron-builder",
    "preview": "vite preview",
    "test": "vitest run",
    "test:sidecar": "node scripts/venv.mjs -m pytest sidecar/tests -q",
    "test:all": "npm run test && npm run test:sidecar",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.2.8",
    "@fontsource/bricolage-grotesque": "^5.2.10",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@react-spring/web": "^9.7.5",
    "@wavesurfer/react": "^1.0.12",
    "react-tinder-card": "^1.6.4",
    "wavesurfer.js": "^7.12.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.8"
  }
}
